# ============================================================
# Docker ELK Secure — Variables de entorno
# ============================================================
# 1. Copia este fichero como .env:   cp .env.example .env
# 2. Edita las contraseñas abajo
# 3. NUNCA hagas commit del fichero .env con valores reales
# ============================================================

# Contraseña del superusuario de Elasticsearch
ELASTIC_PASSWORD=MiPasswordSeguro123

# Contraseña del usuario interno kibana_system
# Debe coincidir con la que configures vía API tras el primer arranque
KIBANA_SYSTEM_PASSWORD=PasswordKibanaSystem

# Contraseña del usuario interno logstash_system (para monitorización)
LOGSTASH_SYSTEM_PASSWORD=PasswordLogstashSystem
